#!/bin/bash

# omarchy-webapps -- run Omarchy web apps in the browser you actually use.
# See README.md. MIT licensed.

set -euo pipefail

OW_ROOT_DIR=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd -P)
OW_LIB_DIR="$OW_ROOT_DIR/lib"
OW_BIN_DIR="$OW_ROOT_DIR/bin"
# shellcheck source=lib/common.sh
source "$OW_LIB_DIR/common.sh"
# shellcheck source=lib/browsers.sh
source "$OW_LIB_DIR/browsers.sh"

usage() {
  cat <<'USAGE'
omarchy-webapps <command>

  status     Show the detected browser and which backend it will use
  doctor     Diagnose the whole path, including the PATH trap and browser prefs
  relink     Point existing web app .desktop entries at this launcher (absolute)
  list       List web apps the browser has registered (Taskbar Tabs backends)
  hypr-rules Print Hyprland window rules for per-app web app windows
  hypr-helpers
             Print Lua overrides that make { webapp = ... } keybindings use this
             launcher (append to ~/.config/hypr/bindings.lua, before the binds)
  chrome-css Install/remove the chrome-less styling for Gecko Taskbar Tabs
             (chrome-css install | chrome-css remove)
  path-shim  Make packaged Omarchy callers that use the bare command name reach
             this launcher (path-shim install | remove | status)
  version    Print the version

Environment / config (~/.config/omarchy-webapps/config, KEY=value):
  browser=<name>.desktop   Force a browser instead of the XDG default
  backend=<backend>        Force chromium-app | gecko-taskbartab | plain-window
  launch_prefix=<cmd>      Override the launch wrapper (default: uwsm-app if present)
USAGE
}

backend_blurb() {
  case "$1" in
  chromium-app)     printf 'Chromium --app= window (shared profile)' ;;
  gecko-taskbartab) printf "Firefox Taskbar Tabs (shared profile, per-app app_id)" ;;
  plain-window)     printf 'ordinary browser window (no SSB support detected)' ;;
  *)                printf '%s' "$1" ;;
  esac
}

cmd_status() {
  load_config
  if ! ow_resolve_browser; then
    bad_mark "no browser resolved (is a default web browser set?)"
    return 1
  fi
  say "browser  : $OW_R_DESKTOP"
  say "binary   : $OW_R_BIN"
  say "family   : $OW_R_FAMILY"
  say "backend  : $OW_R_BACKEND  ($(backend_blurb "$OW_R_BACKEND"))"
  [[ -n $OW_R_PROFILE ]] && say "profile  : $OW_R_PROFILE"
  return 0
}

# The trap that makes name-shadowing unreliable: in a graphical session the
# packaged Omarchy bin can precede ~/.local/bin on PATH, so .desktop launches
# resolve to the packaged script even when a shell resolves to this one.
check_path_order() {
  local self mine
  mine=$(readlink -f -- "$OW_BIN_DIR/omarchy-launch-webapp")
  self=$(command -v omarchy-launch-webapp 2>/dev/null || true)
  if [[ -z $self ]]; then
    warn_mark "omarchy-launch-webapp is not on PATH"
    return
  fi
  if [[ $(readlink -f -- "$self") == "$mine" ]]; then
    ok_mark "PATH resolves omarchy-launch-webapp to this project (in this shell)"
  else
    warn_mark "PATH resolves omarchy-launch-webapp to $self, not this project"
  fi

  local gui_path
  gui_path=$(systemctl --user show-environment 2>/dev/null | sed -n 's/^PATH=//p') || true
  if [[ -n $gui_path ]]; then
    local first_hit
    first_hit=$(env -i PATH="$gui_path" bash -c 'command -v omarchy-launch-webapp' 2>/dev/null || true)
    if [[ -n $first_hit && $(readlink -f -- "$first_hit" 2>/dev/null) != "$mine" ]]; then
      warn_mark "graphical session PATH resolves to $first_hit"
      say "         -> .desktop entries are covered by 'omarchy-webapps relink' (absolute paths)"
      say "         -> packaged callers that use the bare name need 'omarchy-webapps path-shim install'"
    else
      ok_mark "graphical session PATH is not a problem"
    fi
  fi
}

cmd_doctor() {
  local failures=0
  load_config

  if ow_resolve_browser; then
    ok_mark "browser: $OW_R_DESKTOP -> $OW_R_BIN"
    ok_mark "backend: $OW_R_BACKEND ($(backend_blurb "$OW_R_BACKEND"))"
  else
    bad_mark "could not resolve a browser"
    failures=$((failures + 1))
  fi

  if [[ ${OW_R_FAMILY:-} == gecko ]]; then
    local program_dir hint
    hint=${OW_R_DESKTOP%.desktop}; hint=${hint,,}
    program_dir=$(ow_gecko_program_dir "$OW_R_BIN" "$hint")
    if ow_gecko_has_taskbartabs "$program_dir"; then
      ok_mark "browser ships Taskbar Tabs (modules/taskbartabs/ in omni.ja)"
      if [[ -n $OW_R_PROFILE ]] && grep -rqs 'browser.taskbarTabs.enabled".*true' \
           "$OW_R_PROFILE/prefs.js" "$OW_R_PROFILE/user.js"; then
        ok_mark "browser.taskbarTabs.enabled is set"
      else
        warn_mark "browser.taskbarTabs.enabled is NOT set -- web apps will open as ordinary windows"
        say "         -> add  user_pref(\"browser.taskbarTabs.enabled\", true);  to $OW_R_PROFILE/user.js and restart the browser"
      fi
    else
      warn_mark "browser does not ship Taskbar Tabs; falling back to $OW_R_BACKEND"
    fi

    # userChrome.css is inert unless the legacy-stylesheets pref is on, so a
    # chrome-less install can silently do nothing at all.
    if [[ -n $OW_R_PROFILE ]] &&
       grep -qs 'omarchy-webapps:chrome-less' "$OW_R_PROFILE/chrome/userChrome.css"; then
      if grep -rqs 'toolkit.legacyUserProfileCustomizations.stylesheets".*true' \
           "$OW_R_PROFILE/prefs.js" "$OW_R_PROFILE/user.js"; then
        ok_mark "chrome-less styling installed, legacy stylesheets enabled"
      else
        warn_mark "chrome-less styling is installed but toolkit.legacyUserProfileCustomizations.stylesheets is NOT set -- it has no effect"
      fi
    fi
  fi

  check_path_order

  local stale=0 entry exec_line
  for entry in "$OW_APPS_DIR"/*.desktop; do
    [[ -f $entry ]] || continue
    exec_line=$(grep -m1 '^Exec=' "$entry" 2>/dev/null) || continue
    case "$exec_line" in
    "Exec=omarchy-launch-webapp "*|"Exec=omarchy-launch-or-focus-webapp "*|"Exec=omarchy-webapp-handler-"*)
      stale=$((stale + 1)) ;;
    esac
  done
  if ((stale)); then
    warn_mark "$stale web app entry/entries still use a bare command name -- run 'omarchy-webapps relink'"
  else
    ok_mark "no web app entries rely on PATH"
  fi

  say ""
  if ((failures)); then
    say "doctor: $failures failure(s)"
    return 1
  fi
  say "doctor: no failures"
}

# Wrappers for Omarchy's protocol handlers (mailto, zoommtg, launch-or-focus).
# They exec `omarchy-launch-webapp` by bare name, so all a wrapper has to do is
# put this project's bin first on PATH and delegate -- no logic is duplicated,
# so upstream changes to the handler still apply.
#
# Generated into the state dir, never into the checkout, so `relink` cannot
# dirty a git working tree.
ensure_handler_wrapper() {
  local name=$1 target="$OW_GEN_BIN_DIR/$1"
  [[ -x "$OW_PACKAGED_BIN/$name" ]] || return 1
  mkdir -p "$OW_GEN_BIN_DIR"
  cat >"$target" <<WRAP
#!/bin/bash

# Generated by 'omarchy-webapps relink' -- edits will be overwritten.
# $OW_PACKAGED_BIN/$name resolves omarchy-launch-webapp by bare name; putting
# this project's bin first on PATH is the whole job.

exec env PATH="$OW_BIN_DIR:\$PATH" "$OW_PACKAGED_BIN/$name" "\$@"
WRAP
  chmod +x "$target"
}

# Split an Exec= line into its command word and the rest, honouring a leading
# quoted path. Sets REL_CMD / REL_ARGS (REL_ARGS keeps its leading space).
split_exec() {
  local line=${1#Exec=}
  if [[ $line == \"* ]]; then
    REL_CMD=${line:1}; REL_CMD=${REL_CMD%%\"*}
    REL_ARGS=${line#\"$REL_CMD\"}
  else
    REL_CMD=${line%% *}
    REL_ARGS=${line#"$REL_CMD"}
  fi
}

cmd_relink() {
  local dry=0
  [[ ${1:-} == --dry-run ]] && dry=1

  local backup_dir changed=0 skipped=0 entry exec_line new base target
  backup_dir="$OW_STATE_DIR/relink/$(date -u +%Y%m%dT%H%M%SZ)"

  for entry in "$OW_APPS_DIR"/*.desktop; do
    [[ -f $entry ]] || continue
    exec_line=$(grep -m1 '^Exec=' "$entry" 2>/dev/null) || continue

    split_exec "$exec_line"
    base=${REL_CMD##*/}
    new=""

    case "$base" in
    omarchy-launch-webapp)
      # Bare name, or an ad-hoc shim referenced by absolute path: either way
      # point it at this project. Splitting on the command word first means a
      # URL that happens to contain the shim path is never touched.
      target="$OW_BIN_DIR/omarchy-launch-webapp" ;;

    omarchy-launch-or-focus-webapp|omarchy-webapp-handler-*)
      # Adopt these even when they already name an ad-hoc wrapper by absolute
      # path, so a hand-rolled ~/bin wrapper gets superseded rather than left
      # to rot. Handlers Omarchy does not ship (bespoke ones a user wrote) have
      # nothing to wrap, so leave them exactly as they are.
      if ! ensure_handler_wrapper "$base"; then
        [[ $REL_CMD == */* ]] || {
          warn_mark "$(basename "$entry"): no packaged $base to wrap, and it is not on an absolute path"
          skipped=$((skipped + 1))
        }
        continue
      fi
      target="$OW_GEN_BIN_DIR/$base" ;;

    *) continue ;;
    esac

    new="Exec=$target$REL_ARGS"
    [[ $new == "$exec_line" ]] && continue

    if ((dry)); then
      printf 'would rewrite %s\n  %s\n  -> %s\n' "$(basename "$entry")" "$exec_line" "$new"
      continue
    fi

    mkdir -p "$backup_dir"
    cp -a "$entry" "$backup_dir/"
    awk -v repl="$new" '!done && /^Exec=/ { print repl; done=1; next } { print }' \
      "$entry" >"$entry.tmp" && mv "$entry.tmp" "$entry"
    say "rewrote $(basename "$entry")"
    changed=$((changed + 1))
  done

  ((dry)) && return 0
  ((changed)) && say "Backed up $changed original(s): $backup_dir"
  update-desktop-database "$OW_APPS_DIR" 2>/dev/null || true
  say "Done: $changed entry/entries now point at omarchy-webapps."
  ((skipped)) && say "Left alone: $skipped entry/entries this project cannot wrap."
  return 0
}

# The PATH trap, fixed rather than documented: prepend ONE directory, holding
# ONE symlink, to the graphical session PATH. Packaged Omarchy callers that
# resolve `omarchy-launch-webapp` by bare name (omarchy-menu's Learn entries,
# the protocol handlers) then reach this project. Reordering /usr/share/omarchy/bin
# wholesale would also change which omarchy-audio-output-switch etc. runs, which
# is why this shadows exactly one command.
shim_active_path() {
  systemctl --user show-environment 2>/dev/null | sed -n 's/^PATH=//p'
}

cmd_path_shim() {
  case "${1:-status}" in
  install)
    mkdir -p "$OW_SHIM_DIR" "$OW_ENV_DIR"
    ln -sfn -- "$OW_BIN_DIR/omarchy-launch-webapp" "$OW_SHIM_DIR/omarchy-launch-webapp"
    cat >"$OW_ENV_FILE" <<CONF
# Written by 'omarchy-webapps path-shim install'. Safe to delete.
#
# $OW_SHIM_DIR holds a single symlink: omarchy-launch-webapp. Putting it first
# makes packaged callers that use the bare command name reach this project,
# without shadowing any other Omarchy command.
PATH=$OW_SHIM_DIR:\${PATH}
CONF
    ok_mark "shim: $OW_SHIM_DIR/omarchy-launch-webapp"
    ok_mark "env : $OW_ENV_FILE"
    say ""
    say "New graphical sessions pick this up automatically. To apply to newly"
    say "launched apps in the current session without logging out:"
    say "  systemctl --user set-environment PATH=\"$OW_SHIM_DIR:\$(systemctl --user show-environment | sed -n 's/^PATH=//p')\""
    say ""
    say "Already-running processes keep the PATH they started with, so Hyprland"
    say "keybindings only change after the next login."
    ;;

  remove)
    local removed=0
    if [[ -f $OW_ENV_FILE ]]; then
      rm -f -- "$OW_ENV_FILE"; say "removed $OW_ENV_FILE"; removed=1
    fi
    if [[ -d $OW_SHIM_DIR ]]; then
      rm -rf -- "$OW_SHIM_DIR"; say "removed $OW_SHIM_DIR"; removed=1
    fi
    ((removed)) || say "nothing to remove"
    ;;

  status)
    local gui_path resolved
    if [[ -L "$OW_SHIM_DIR/omarchy-launch-webapp" && -f $OW_ENV_FILE ]]; then
      ok_mark "shim installed ($OW_ENV_FILE)"
    else
      warn_mark "shim not installed -- run 'omarchy-webapps path-shim install'"
    fi
    gui_path=$(shim_active_path)
    if [[ -n $gui_path ]]; then
      resolved=$(env -i PATH="$gui_path" bash -c 'command -v omarchy-launch-webapp' 2>/dev/null || true)
      if [[ -n $resolved && $(readlink -f -- "$resolved" 2>/dev/null) == $(readlink -f -- "$OW_BIN_DIR/omarchy-launch-webapp") ]]; then
        ok_mark "graphical session PATH already resolves to this project"
      else
        warn_mark "graphical session PATH still resolves to ${resolved:-nothing} (log out and back in to apply)"
      fi
    fi
    ;;

  *) die "usage: omarchy-webapps path-shim install|remove|status" ;;
  esac
}

cmd_list() {
  load_config
  ow_resolve_browser || die "no browser resolved"
  [[ $OW_R_BACKEND == gecko-taskbartab ]] || die "list is only meaningful for the gecko-taskbartab backend"
  OW_REGISTRY="$OW_R_PROFILE/taskbartabs/taskbartabs.json" python3 - <<'PY'
import json, os, sys
try:
    data = json.load(open(os.environ["OW_REGISTRY"]))
except (OSError, ValueError):
    print("no web apps registered yet")
    sys.exit(0)
tabs = data.get("taskbarTabs", [])
if not tabs:
    print("no web apps registered yet")
for t in tabs:
    hosts = ", ".join(s.get("hostname", "?") for s in t.get("scopes", []))
    print("%-28s %-34s %s" % (t.get("name", "?"), hosts, t.get("id", "?")))
PY
}

cmd_hypr_rules() {
  load_config
  ow_resolve_browser >/dev/null 2>&1 || true
  local prgname=zen
  [[ -n ${OW_R_DESKTOP:-} ]] && prgname=${OW_R_DESKTOP%.desktop}
  cat <<RULES
-- Web app windows get their own Wayland app_id: ${prgname}.webapp-<uuid>.
-- Put this in a file required AFTER any file that sets opacity by tag, since the
-- last matching rule wins for a given property.

o.window("^(${prgname}\\\\.webapp-)", {
  border_size = 0,
  no_shadow = true,
  opacity = "1 1",
})
RULES
}

# Omarchy's own Hyprland helpers build `omarchy-launch-webapp <url>` as a bare
# command name, and Hyprland's exec PATH puts /usr/share/omarchy/bin first -- so
# every { webapp = ... } keybinding reaches the packaged Chromium launcher. There
# is no .desktop file to relink and no way to edit the packaged helpers, so the
# fix is to override the two helper functions in the user's own bindings.lua.
#
# `omarchy-launch-or-focus-webapp` needs the wrapper rather than a direct path:
# it re-resolves omarchy-launch-webapp by bare name internally.
cmd_hypr_helpers() {
  local sole="omarchy-launch-or-focus-webapp" sole_path
  if ensure_handler_wrapper "$sole"; then
    sole_path="$OW_GEN_BIN_DIR/$sole"
  else
    sole_path="$OW_PACKAGED_BIN/$sole"
  fi

  cat <<LUA
-- omarchy-webapps: name the web app launcher by absolute path.
--
-- Hyprland's exec PATH puts /usr/share/omarchy/bin first, so the bare command
-- name in Omarchy's helpers resolves to the packaged Chromium-only launcher.
-- Overriding these two functions fixes every { webapp = ... } binding at once.
-- Must come BEFORE the o.bind() calls that use them.

-- Shell single-quoting. Built from char codes (39 = apostrophe, 92 = backslash)
-- so no layer of Lua or shell escaping can mangle it.
local ow_q = string.char(39)
local ow_esc = ow_q .. string.char(92) .. ow_q .. ow_q

local function ow_quote(s)
  return ow_q .. (tostring(s):gsub(ow_q, ow_esc)) .. ow_q
end

function o.launch_webapp(url)
  return "$OW_BIN_DIR/omarchy-launch-webapp " .. ow_quote(url)
end

function o.launch_webapp_sole(name, url)
  return "$sole_path " .. ow_quote(name) .. " " .. ow_quote(url)
end
LUA
}

cmd_chrome_css() {
  load_config
  ow_resolve_browser || die "no browser resolved"
  [[ $OW_R_FAMILY == gecko ]] || die "chrome-css only applies to Gecko browsers"
  [[ -n $OW_R_PROFILE ]] || die "could not find the browser profile"

  local target="$OW_R_PROFILE/chrome/userChrome.css"
  local marker="omarchy-webapps:chrome-less"

  case "${1:-}" in
  install)
    mkdir -p "$(dirname "$target")"
    if [[ -f $target ]] && grep -q "$marker" "$target"; then
      say "already installed: $target"
      return 0
    fi
    [[ -f $target ]] && cp -a "$target" "$target.bak.$(date -u +%Y%m%dT%H%M%SZ)"
    cat "$OW_ROOT_DIR/share/webapp-chrome.css" >>"$target"
    say "installed chrome-less styling into $target"
    say "Also set toolkit.legacyUserProfileCustomizations.stylesheets=true, then restart the browser."
    ;;
  remove)
    [[ -f $target ]] || { say "nothing to remove"; return 0; }
    cp -a "$target" "$target.bak.$(date -u +%Y%m%dT%H%M%SZ)"
    awk -v m="$marker" '
      $0 ~ ("/\\* " m) { skip=1 }
      skip && $0 ~ (m " end \\*/") { skip=0; next }
      !skip { print }' "$target" >"$target.tmp" && mv "$target.tmp" "$target"
    say "removed chrome-less styling from $target"
    ;;
  *)
    die "usage: omarchy-webapps chrome-css install|remove" ;;
  esac
}

case "${1:-}" in
status)     shift; cmd_status "$@" ;;
doctor)     shift; cmd_doctor "$@" ;;
relink)     shift; cmd_relink "$@" ;;
list)       shift; cmd_list "$@" ;;
hypr-rules) shift; cmd_hypr_rules "$@" ;;
hypr-helpers) shift; cmd_hypr_helpers "$@" ;;
chrome-css) shift; cmd_chrome_css "$@" ;;
path-shim)  shift; cmd_path_shim "$@" ;;
version|--version|-V) printf '%s %s\n' "$OW_NAME" "$OW_VERSION" ;;
-h|--help|help|"") usage ;;
*) usage; exit 1 ;;
esac
